<main class="industry-page">
  <section class="solution-hero industry-hero"><p class="v2-eyebrow">{{ industry.label }}</p><h1>{{ industry.headline }}</h1><p class="solution-lede">{{ industry.description }}</p><a class="btn-lime" href="/contact/?industry={{ industry.slug }}" data-track="cta_growth_plan" data-track-label="{{ industry.slug }}">{{ industry.cta }} <span class="arr">↗</span></a></section>
  <section class="industry-problems"><div><p class="v2-eyebrow">The common constraint</p><h2>{{ industry.problemHeading }}</h2></div><ul>{% for item in industry.problems %}<li>{{ item }}</li>{% endfor %}</ul></section>
  <section class="industry-system"><p class="v2-eyebrow">The growth system</p><h2>Strategy <i>→</i> Brand <i>→</i> Content <i>→</i> Demand <i>→</i> Growth</h2><p>{{ industry.system }}</p><div class="industry-capabilities">{% for item in industry.capabilityLinks %}<a href="{{ item.url }}">{{ item.label }}</a>{% endfor %}</div></section>
  <section class="industry-solutions"><div><p class="v2-eyebrow">Recommended systems</p><h2>Start with the outcome that matters most now.</h2><p>Your industry context informs the approach. The actual system is built around the immediate business problem.</p></div><div>{% for item in industry.solutions %}<a href="{{ item.url }}"><strong>{{ item.label }}</strong><span>{{ item.description }} →</span></a>{% endfor %}</div></section>
  <section class="industry-process"><p class="v2-eyebrow">How we apply it</p><div>{% for item in industry.process %}<article><span>0{{ loop.index }}</span><h3>{{ item.title }}</h3><p>{{ item.description }}</p></article>{% endfor %}</div></section>
  <section class="industry-proof"><div><p class="v2-eyebrow">Relevant proof</p><h2>Explore the work behind the system.</h2><p>See verified ScratchBox projects across brand, digital experience, campaigns and content.</p><a class="btn-ink" href="/work/">See Our Work <span class="arr">↗</span></a></div><div class="industry-proof-image" style="background-image:url('{{ industry.cover }}')"></div></section>
  <section class="industry-faq"><p class="v2-eyebrow">Common questions</p><div><article><h3>Do you only work with {{ industry.label }} companies?</h3><p>This page explains a specific growth context. ScratchBox works across categories when the business problem and fit are right.</p></article><article><h3>Can we begin with one priority?</h3><p>Yes. The Growth Plan helps identify whether the right starting point is brand, launch, content, demand or an integrated partnership.</p></article><article><h3>How do we know what system we need?</h3><p>We begin with your objectives, constraints and current maturity, then recommend the most relevant path forward.</p></article></div></section>
  <section class="solution-cta"><p class="v2-eyebrow">Make the next move deliberate</p><h2>{{ industry.cta }}</h2><a class="btn-lime" href="/contact/?industry={{ industry.slug }}" data-track="cta_growth_plan" data-track-label="{{ industry.slug }}-bottom">Get My Growth Plan <span class="arr">↗</span></a></section>
</main>
{% include "partials/footer.njk" %}
