<!-- Project Form Modal -->
<div class="project-modal-overlay" id="projectModal">
  <div class="project-modal-box">
    <div class="project-modal-header">
      <div>
        <div class="project-modal-title">Start your Growth Plan</div>
        <div class="project-modal-sub">Share the context and we will identify the right next step.</div>
      </div>
      <button class="project-modal-close" onclick="closeProjectForm()">✕</button>
    </div>
    <div class="project-modal-body">
      <form class="contact-form" onsubmit="handleProjectSubmit(event)">
        <p class="growth-plan-required-note"><span aria-hidden="true">*</span> Required fields</p>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Full Name <span class="required-mark" aria-hidden="true">*</span></label>
            <input class="form-input" type="text" name="name" placeholder="Your name" required/>
          </div>
          <div class="form-group">
            <label class="form-label">Email <span class="required-mark" aria-hidden="true">*</span></label>
            <input class="form-input" type="email" name="email" placeholder="grow@scratchbox.media" required/>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Phone</label>
            <input class="form-input" type="tel" name="phone" placeholder="+91 9xxxx xxxxx"/>
          </div>
          <div class="form-group">
            <label class="form-label">Company</label>
            <input class="form-input" type="text" name="company" placeholder="Brand or startup name"/>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Investment Range</label>
            <select class="form-select" name="budget">
              <option value="" selected>Select a range</option>
              <option value="1-3l">₹1–3L</option>
              <option value="3-5l">₹3–5L</option>
              <option value="5-10l">₹5–10L</option>
              <option value="10l-plus">₹10L+</option>
              <option value="not-sure">Not sure — help me scope it</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Timeline</label>
            <select class="form-select" name="timeline">
              <option value="" selected>Select timeline</option>
              <option value="asap">ASAP (within 4 weeks)</option>
              <option value="1-3">1–3 months</option>
              <option value="3-6">3–6 months</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Project Details <span class="required-mark" aria-hidden="true">*</span></label>
          <textarea class="form-textarea" name="details" placeholder="Tell us about your goals, scope, and what you need help with." required></textarea>
        </div>
        <button class="form-submit" type="submit">Get My Growth Plan <span class="arr">→</span></button>
      </form>
    </div>
  </div>
</div>

