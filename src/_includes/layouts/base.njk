<!-- ========================
     PROJECT PLANNER MODAL
========================= -->
<div class="planner-modal-overlay" id="plannerModal">
  <div class="planner-box">
    <div class="planner-header">
      <div>
        <div class="planner-title">🎯 Project Planner</div>
        <div class="planner-sub">2 minutes — we'll recommend the perfect plan for you</div>
      </div>
      <button class="planner-close" onclick="closePlanner()">✕</button>
    </div>
    <div class="planner-progress-bar"><div class="planner-progress-fill" id="plannerProgress" style="width:20%"></div></div>

    <div class="planner-body" id="plannerBody">
      <!-- Step 1 -->
      <div class="quiz-step active" id="qstep-1">
        <div class="quiz-question">What stage is your business at?</div>
        <div class="quiz-hint">This helps us understand your starting point.</div>
        <div class="quiz-options">
          <button class="quiz-option" onclick="selectOption(this,'stage','idea')">
            <span class="quiz-option-icon">💡</span>
            <div class="quiz-option-text"><strong>Just an idea</strong><span>I'm pre-launch, still figuring things out</span></div>
          </button>
          <button class="quiz-option" onclick="selectOption(this,'stage','early')">
            <span class="quiz-option-icon">🌱</span>
            <div class="quiz-option-text"><strong>Early-stage startup</strong><span>I've launched but need to grow</span></div>
          </button>
          <button class="quiz-option" onclick="selectOption(this,'stage','growing')">
            <span class="quiz-option-icon">📈</span>
            <div class="quiz-option-text"><strong>Growing business</strong><span>I have traction and want to scale</span></div>
          </button>
          <button class="quiz-option" onclick="selectOption(this,'stage','established')">
            <span class="quiz-option-icon">🏢</span>
            <div class="quiz-option-text"><strong>Established brand</strong><span>Refresh, reposition, or expand</span></div>
          </button>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="quiz-step" id="qstep-2">
        <div class="quiz-question">What's your primary goal right now?</div>
        <div class="quiz-hint">Pick the one that matters most.</div>
        <div class="quiz-options">
          <button class="quiz-option" onclick="selectOption(this,'goal','brand')">
            <span class="quiz-option-icon">🎨</span>
            <div class="quiz-option-text"><strong>Build a brand identity</strong><span>Logo, visuals, positioning, messaging</span></div>
          </button>
          <button class="quiz-option" onclick="selectOption(this,'goal','web')">
            <span class="quiz-option-icon">🌐</span>
            <div class="quiz-option-text"><strong>Get a high-performing website</strong><span>Design, development, SEO</span></div>
          </button>
          <button class="quiz-option" onclick="selectOption(this,'goal','content')">
            <span class="quiz-option-icon">📱</span>
            <div class="quiz-option-text"><strong>Create content that converts</strong><span>Video, social media, campaigns</span></div>
          </button>
          <button class="quiz-option" onclick="selectOption(this,'goal','grow')">
            <span class="quiz-option-icon">🚀</span>
            <div class="quiz-option-text"><strong>Grow my audience & revenue</strong><span>Ads, marketing, GTM strategy</span></div>
          </button>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="quiz-step" id="qstep-3">
        <div class="quiz-question">What's your monthly budget range?</div>
        <div class="quiz-hint">Choose the closest range.</div>
        <div class="quiz-options">
          <button class="quiz-option" onclick="selectOption(this,'budget','under-30k')">
            <span class="quiz-option-icon">💸</span>
            <div class="quiz-option-text"><strong>Under ₹30,000/mo</strong><span>Budget-focused, need essentials</span></div>
          </button>
          <button class="quiz-option" onclick="selectOption(this,'budget','30k-75k')">
            <span class="quiz-option-icon">📦</span>
            <div class="quiz-option-text"><strong>₹30,000 – ₹75,000/mo</strong><span>Ready to invest in growth</span></div>
          </button>
          <button class="quiz-option" onclick="selectOption(this,'budget','75k-plus')">
            <span class="quiz-option-icon">💼</span>
            <div class="quiz-option-text"><strong>₹75,000+/mo</strong><span>Looking for a dedicated growth partner</span></div>
          </button>
          <button class="quiz-option" onclick="selectOption(this,'budget','project')">
            <span class="quiz-option-icon">🧩</span>
            <div class="quiz-option-text"><strong>One-off project budget</strong><span>I need something specific, not ongoing</span></div>
          </button>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="quiz-step" id="qstep-4">
        <div class="quiz-question">How soon do you want to start?</div>
        <div class="quiz-hint">This helps us match the timeline.</div>
        <div class="quiz-options">
          <button class="quiz-option" onclick="selectOption(this,'timeline','asap')">
            <span class="quiz-option-icon">⚡</span>
            <div class="quiz-option-text"><strong>ASAP (within 4 weeks)</strong><span>I want to start now</span></div>
          </button>
          <button class="quiz-option" onclick="selectOption(this,'timeline','1-3')">
            <span class="quiz-option-icon">🗓️</span>
            <div class="quiz-option-text"><strong>1–3 months</strong><span>Planning ahead but soon</span></div>
          </button>
          <button class="quiz-option" onclick="selectOption(this,'timeline','3-6')">
            <span class="quiz-option-icon">📅</span>
            <div class="quiz-option-text"><strong>3–6 months</strong><span>Thinking longer-term</span></div>
          </button>
          <button class="quiz-option" onclick="selectOption(this,'timeline','6-plus')">
            <span class="quiz-option-icon">🔮</span>
            <div class="quiz-option-text"><strong>6+ months</strong><span>Just exploring options</span></div>
          </button>
        </div>
      </div>

      <!-- Step 5 (result) -->
      <div class="quiz-step" id="qstep-result">
        <div class="quiz-result">
          <div class="quiz-result-icon">✅</div>
          <div class="quiz-result-title" id="resultTitle">Here’s what we recommend</div>
          <div class="quiz-result-desc" id="resultDesc">We’ll suggest a plan based on your choices.</div>
          <div class="quiz-result-tags" id="resultTags"></div>
          <div class="quiz-result-actions">
            <button class="btn-lime" onclick="closePlanner();openCalendly();" style="border:none;width:100%;justify-content:center;" data-track="quiz_result_cta" data-track-label="book_call">Book Your Free Strategy Call <span class="arr">↗</span></button>
            <a href="https://api.whatsapp.com/send?phone=919928106169&text=Hi%20ScratchBox!%20I%20just%20completed%20your%20project%20quiz%20and%20would%20love%20to%20chat." target="_blank" data-track="quiz_result_cta" data-track-label="whatsapp" style="display:flex;align-items:center;justify-content:center;gap:8px;padding:13px;border-radius:12px;border:1.5px solid var(--border);color:var(--ink);font-weight:600;font-size:14px;text-decoration:none;">💬 Chat on WhatsApp Instead</a>
          </div>
        </div>
      </div>
    </div>
    <div class="quiz-nav" id="quizNav">
      <button class="quiz-back" id="quizBack" onclick="quizBack()" style="display:none;">← Back</button>
      <div class="quiz-step-counter" id="stepCounter">Step 1 of 4</div>
      <button class="quiz-next" id="quizNext" onclick="quizNext()" disabled>Next <span class="arr">↗</span></button>
    </div>
  </div>
</div>

<script src="/assets/js/site.js?v=7" defer></script>
