  <section class="legal-hero"><p class="v2-eyebrow">Legal</p><h1>Privacy <em>Policy</em></h1><p>How {{ site.legal.controllerName }} collects, uses, shares and protects personal information when you visit our website or contact us.</p><small>Effective date: {{ site.legal.effectiveDate }}</small></section>
